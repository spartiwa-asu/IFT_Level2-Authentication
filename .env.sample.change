# Project settings, read by server.js and dev-data/seed.js.
# .env wins over config.env; terminal variables win over both. Never commit or submit this file.

NODE_ENV=development
PORT=4001
API_VERSION=/api/v1
STUDENT_NAME="Your Full Name"
STUDENT_ID="Your ten-digit ASU ID"
BCRYPT_ROUNDS=12

# MongoDB Atlas. server.js fills the placeholders in DATABASE_URL:
#   <db_username> <- DATABASE_USER
#   <db_password> <- DATABASE_PWD   (plain text; server.js URI-encodes it)
#   <db_name>     <- DATABASE_NAME
DATABASE_URL=mongodb+srv://<db_username>:<db_password>@ift458cluster.zbf4eqg.mongodb.net/<db_name>
DATABASE_USER=dbuser
DATABASE_PWD=2026Password
DATABASE_NAME=LoanDB

# Local MongoDB alternative (e.g. `docker run -d -p 27017:27017 mongo`):
# replace the DATABASE_URL line above with this one.
# DATABASE_URL=mongodb://127.0.0.1:27017/ift458_level2

# Optional: set false to disable public IP/geolocation lookup in the run log.
# LOG_GEO=false

# Copy this file to .env in the project root and fill in your own values.
# .env wins over config.env. Never commit or submit .env or config.env.

NODE_ENV=development
PORT=4001
API_VERSION=/api/v1

# Option A - local MongoDB (e.g. `docker run -d -p 27017:27017 mongo`)
DATABASE_URL=mongodb://127.0.0.1:27017/ift458_level2
DATABASE_PASSWORD=

# Option B - MongoDB Atlas (uncomment these settings and replace Option A)
# DATABASE_URL=mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/<db_name>
# DATABASE_USER=your-atlas-database-user
# DATABASE_PWD=your-atlas-password
# DATABASE_NAME=LoanDB

# Fill these in to identify your assignment evidence.
STUDENT_NAME=
STUDENT_ID=

# bcrypt cost (work factor). The salt is random per password - see models/userModel.js.
BCRYPT_ROUNDS=12

# Login token lifetime in minutes (default 1440 = 24 hours).
# Set 1 to watch a token expire (BREAKPOINT 14), then restart the server.
TOKEN_LIFETIME_MINUTES=1440

# CORS: other websites allowed to call this API from a browser, comma separated.
# Swagger (/api-docs) is on this same server and does not need an entry.
# http://localhost:5173 is the browser client (npm run client). If you open the
# client by IP address, add that origin too, e.g. http://192.168.1.5:5173
CORS_ORIGINS=http://localhost:5173

# JWT lab only (labs/jwt-walkthrough.js) - the API itself does not use JWTs.
# Generate your own secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_LIFETIME_SECONDS=5

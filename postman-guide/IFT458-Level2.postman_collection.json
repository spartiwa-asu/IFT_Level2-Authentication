{
  "info": {
    "name": "IFT 458 Level 2 - Authentication (end to end)",
    "description": "Run the folders in order: 1 Authentication, 2 Games, 3 Scores, 4 Common mistakes.\n\nThe collection uses Authorization -> Bearer Token with the value {{token}}. \"Log in\" saves the token for you. In the Bearer Token field you paste ONLY the token: Postman adds the word \"Bearer \" itself.\n\nSet baseUrl in the collection Variables tab if your API is not on http://localhost:4001.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4001/api/v1"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "password12345"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "gameId",
      "value": ""
    },
    {
      "key": "scoreId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Authentication",
      "description": "No token needed. Signup and login are public.",
      "item": [
        {
          "name": "Sign up",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new email every run, so the collection can be run again without a 409 \"already registered\"",
                  "pm.collectionVariables.set(\"email\", `student${Date.now()}@ift458.test`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"No password in the response\", () => pm.expect(JSON.stringify(pm.response.json())).to.not.include(\"password\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/users/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "signup"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"passwordConfirmation\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Log in (saves the token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "pm.test(\"Token is 64 hex characters\", () => pm.expect(token).to.match(/^[a-f0-9]{64}$/));",
                  "// Saved WITHOUT the word Bearer: the collection's Bearer Token auth adds \"Bearer \" itself",
                  "pm.collectionVariables.set(\"token\", token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Log in with a wrong password (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Same message as an unknown email\", () => pm.expect(pm.response.json().message).to.eql(\"Incorrect email or password.\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"not-the-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2 Games",
      "description": "Every request inherits Authorization -> Bearer Token {{token}} from the collection.",
      "item": [
        {
          "name": "List games WITHOUT a token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/games",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "games"
              ]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "List games",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has a games array\", () => pm.expect(pm.response.json().data.games).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/games",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "games"
              ]
            },
            "header": []
          }
        },
        {
          "name": "Create a game (saves gameId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"gameId\", pm.response.json().data.game._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/games",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "games"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Stardew Valley\",\n  \"developer\": \"ConcernedApe\",\n  \"genre\": \"Simulation\",\n  \"description\": \"Farm, fish and make friends.\",\n  \"platform\": \"pc\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get the game",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/games/{{gameId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "games",
                "{{gameId}}"
              ]
            },
            "header": []
          }
        },
        {
          "name": "Update the game",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Genre changed\", () => pm.expect(pm.response.json().data.game.genre).to.eql(\"Farming simulation\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/games/{{gameId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "games",
                "{{gameId}}"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"genre\": \"Farming simulation\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete the game",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/games/{{gameId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "games",
                "{{gameId}}"
              ]
            },
            "header": []
          }
        },
        {
          "name": "Get the deleted game (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/games/{{gameId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "games",
                "{{gameId}}"
              ]
            },
            "header": []
          }
        }
      ]
    },
    {
      "name": "3 Scores",
      "item": [
        {
          "name": "Submit a score (saves scoreId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Starts as submitted\", () => pm.expect(pm.response.json().data.score.status).to.eql(\"submitted\"));",
                  "pm.collectionVariables.set(\"scoreId\", pm.response.json().data.score._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/scores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scores"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gameTitle\": \"Stardew Valley\",\n  \"points\": 4200,\n  \"playerEmail\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List scores",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/scores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scores"
              ]
            },
            "header": []
          }
        },
        {
          "name": "Mark the score verified (any user can - no authorization yet)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Now verified\", () => pm.expect(pm.response.json().data.score.status).to.eql(\"verified\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/scores/{{scoreId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scores",
                "{{scoreId}}"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"verified\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete the score",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/scores/{{scoreId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scores",
                "{{scoreId}}"
              ]
            },
            "header": []
          }
        }
      ]
    },
    {
      "name": "4 Common mistakes with \"Bearer\"",
      "description": "These requests set the Authorization header by hand (Headers tab) with auth set to No Auth, to show what each mistake sends.",
      "item": [
        {
          "name": "Mistake: \"Bearer Bearer <token>\" (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/games",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "games"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer Bearer {{token}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "What happens when you type \"Bearer \" in front of the token in the Bearer Token field: Postman adds its own, so the server gets \"Bearer Bearer <token>\"."
          }
        },
        {
          "name": "Mistake: token with no \"Bearer\" word (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/games",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "games"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "In the Headers tab you must type the word yourself: Bearer, one space, then the token."
          }
        },
        {
          "name": "Correct: header typed by hand \"Bearer <token>\" (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/games",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "games"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}
